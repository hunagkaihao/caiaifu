    "SqliteLogConnString": "Data Source=D:\\Log\\Ecs\\abp.pcslog.db",
    "LogClearInterval": 86400000,
    "LogMaxVolume": 50000,
    "RedisConnStr": "127.0.0.1:6379",
    "DefaultRedisNo": 0,
    "PlcRedisNo": 1,
    "RemovePlcTagTempValueOnStart": true,
    "HeartBeatsFromPlc": [
    ],
    "HeartBeatsToPlc": [
    ],
    "PlcTagMonitors": [
      "Plc1.Lm_Cmd",
      "Plc1.Lm_Response",
      "Plc1.Door1_Cmd",
      "Plc1.Door1_Response",
      "Plc1.Door2_Cmd",
      "Plc1.Door2_Response",
      "Plc1.Door3_Cmd",
      "Plc1.Door3_Response",
      "Plc1.Door4_Cmd",
      "Plc1.Door4_Response",
      "Plc1.Door5_Cmd",
      "Plc1.Door5_Response",
      "Plc1.Lm_State",
      "Plc1.Lm_Zero",
      "Plc1.EmergencyStop"
    ],
    // ---------- AGV-PLC 新协议（搬运申请）----------
    // 四条生产线 O1～O4，每条四点位 O{n}A～O{n}D；PLC 为 TCP 服务端，本系统为客户端长连接。
    // Redis：每点位 Hash「AgvPlc:Point:O1A」…「AgvPlc:Point:O4D」；派发按序号9/10 匹配八向边写入 AgvTransportTasks。
    // Lines.Ox.TcpEnabled：是否为本线四 PLC 建 TCP；Lines.Ox.EdgeDispatchEnabled：是否为本线定时派发任务。
    // DefaultEdgeDispatchPollIntervalSeconds：各线 EdgeDispatchPollIntervalSeconds 为 0 时采用的默认派发间隔（秒）。
    // 海康 RCS-2000 国标：代理 2.1.2/2.1.3/2.1.4；RCS 回调 2.2.1 → POST /api/robot/reporter/task。AgvEnabled=false 时不请求 RCS、直接返回成功。
    "Rcs": {
      "AgvEnabled": false,
      "Host": "100.100.10.11",
      "Port": 0,
      "UseHttps": true,
      "SkipSslValidation": true,
      "AppKey": "",
      "AppSecret": "",
      "Usr": "ecs",
      "ApiVersion": "v1.0"
    },
    "AgvPlcTcp": {
      // 是否启用：false 时不启动四路 TCP、不做派发（调试或未接 PLC 时请保持 false）
      "Enabled": true,
      // 断线或异常后等待多久再重连（毫秒）
      "ReconnectDelayMs": 3000,
      // Socket 读超时（毫秒）
      "ReceiveTimeoutMs": 5000,
      // 单帧长度：PLC 读状态「应答」为 8 字节（如 59 00 00 00 00 00 00 00）；程序取第 1 字节解析状态位
      "FrameLength": 8,
      // 可选帧同步前缀（HEX 无空格）；一般留空。仅当流前有杂字节且每帧有固定前缀时再填
      "FrameSyncPrefixHex": "",
      // 向 PLC 发读状态：单字节 0x01（两位 HEX「01」）；留空则不主动发读
      "PollCommandHex": "01",
      // 每隔多少秒向该点位 PLC 发送一次读状态（与 PollCommandHex 配合）；0 表示不按周期发（若 SendReadPollImmediatelyOnConnect 为 true 仍会连上后发一次）
      "ReadStatusPollIntervalSeconds": 5,
      //这里是秒

      // 连接成功后是否立即发一次读状态
      "SendReadPollImmediatelyOnConnect": true,
      // 以下为技术文档 PLC→AGV：第 2 字节=允许取、第 3 字节=允许放（程序内 0 起始下标为 1、2）
      "AllowPickupByteIndex": 1,
      "AllowPlaceByteIndex": 2,
      // 为真时的字节值：文档为 1 → 十六进制每字节发 01
      "ActiveStateByteValue": 1,
      // false：仅当字节等于 ActiveStateByteValue 为真；true：字节非 0 即真（旧 bitmask 调试用）
      "AllowNonZeroAsActive": false,
      "DefaultEdgeDispatchPollIntervalSeconds": 1,
      // 每条线四位端口：91xx / 92xx / 93xx / 94xx（A=01 … D=04）；线与线之间千位不同，同线内四口仍互不重复。
      "Lines": {
        "O1": {
          "TcpEnabled": false,
          "EdgeDispatchEnabled": true,
          "EdgeDispatchPollIntervalSeconds": 0,
          "Endpoints": {
            "O1A": {
              "Host": "127.0.0.1",
              "Port": 9101
            },
            "O1B": {
              "Host": "127.0.0.1",
              "Port": 9102
            },
            "O1C": {
              "Host": "127.0.0.1",
              "Port": 9103
            },
            "O1D": {
              "Host": "127.0.0.1",
              "Port": 9104
            }
          }
        },
        "O2": {
          "TcpEnabled": true,
          "EdgeDispatchEnabled": true,
          "EdgeDispatchPollIntervalSeconds": 0,
          "Endpoints": {
            "O2A": {
              "Host": "127.0.0.1",
              "Port": 9201
            },
            "O2B": {
              "Host": "127.0.0.1",
              "Port": 9202
            },
            "O2C": {
              "Host": "127.0.0.1",
              "Port": 9203
            },
            "O2D": {
              "Host": "127.0.0.1",
              "Port": 9204
            }
          }
        },
        "O3": {
          "TcpEnabled": false,
          "EdgeDispatchEnabled": true,
          "EdgeDispatchPollIntervalSeconds": 0,
          "Endpoints": {
            "O3A": {
              "Host": "127.0.0.1",
              "Port": 9301
            },
            "O3B": {
              "Host": "127.0.0.1",
              "Port": 9302
            },
            "O3C": {
              "Host": "127.0.0.1",
              "Port": 9303
            },
            "O3D": {
              "Host": "127.0.0.1",
              "Port": 9304
            }
          }
        },
        "O4": {
          "TcpEnabled": false,
          "EdgeDispatchEnabled": true,
          "EdgeDispatchPollIntervalSeconds": 0,
          "Endpoints": {
            "O4A": {
              "Host": "127.0.0.1",
              "Port": 9401
            },
            "O4B": {
              "Host": "127.0.0.1",
              "Port": 9402
            },
            "O4C": {
              "Host": "127.0.0.1",
              "Port": 9403
            },
            "O4D": {
              "Host": "127.0.0.1",
              "Port": 9404
            }
          }
        }
      }
    }
  }
}
